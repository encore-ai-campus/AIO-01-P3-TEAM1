# 관리 서버의 ~/paper_admin/.env (권한 0600). README.md 7장. 비밀 값은 이 파일에만 둔다 (저장소에 넣지 않는다).

# secrets/(tunnel_key, known_hosts)와 records/deploys.jsonl이 있는 폴더 (compose.yml은 ~/paper_admin/app/에 있다)
ADMIN_HOME=/home/ubuntu/paper_admin

# 세션 쿠키 서명 키 (32자 이상): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=

# 서비스 DB 읽기 전용 계정 paper_admin_ro의 비밀번호 (readonly_role.sql을 돌릴 때 넣은 값)과 DB 이름
ADMIN_DB_PASSWORD=
SERVICE_DB_NAME=paper

# 서비스 서버로 가는 SSH 터널: 서비스 서버의 전용 사용자@주소, SSH 포트, 서비스 compose의 DB_LOCAL_PORT
TUNNEL_TARGET=admin-tunnel@52.78.101.101
TUNNEL_PORT=22
DB_LOCAL_PORT=15432

# F3 서비스 상태로 확인할 주소 (/api/health와 /를 부른다)와 간격(초)
ADMIN_SERVICE_URL=http://52.78.101.101
ADMIN_HEALTH_INTERVAL_SEC=30

# 관리자 화면을 여는 주소·포트. 127.0.0.1이면 ssh -L로만 들어온다. 운영(퍼블릭 IP로 열기)은 0.0.0.0 + 80 (README 9장)
ADMIN_HTTP_BIND=0.0.0.0
ADMIN_HTTP_PORT=80
# 쿠키 Secure 플래그 (HTTPS가 아니면 off)
ADMIN_COOKIE_SECURE=off
