# 개발용 기본값. 복사해서 .env로 쓰고 비밀 값을 채운다. .env는 커밋하지 않는다 (운영 값은 EC2의 .env에만).
# 키 설명은 docs/DECISIONS.md 2장.

# --- 키움 REST API (조회만 쓴다. 계좌·주문 TR은 쓰지 않는다) ---
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# KIWOOM_BASE_URL=https://api.kiwoom.com
# KIWOOM_TOKEN_CACHE=.cache/kiwoom_token.json

# --- 로컬 개발 전용: 키움 대신 토스증권 Open API로 조회한다 (조회만. 계좌·주문 API는 코드에 없다) ---
# EC2 운영에는 넣지 않는다 (DJANGO_DEBUG=on일 때만 BROKER=toss를 받는다. 예외: 키움 키를 받기 전 운영 임시 ALLOW_TOSS_BROKER=on). 설명은 docs/DECISIONS.md 3장.
# 토스 토큰은 client당 1개만 유효하다. 운영 중인 원본 toss_trading과 같은 CLIENT_ID를 쓰면 서로의 토큰을
# 무효로 만드니 개발용 client를 따로 발급해 쓴다.
# BROKER=toss
# CLIENT_ID=
# CLIENT_SECRET=
# 키움 키를 받기 전 운영 임시용: DJANGO_DEBUG=off여도 BROKER=toss를 받는다 (기본 off. 로컬 개발은 DJANGO_DEBUG=on이면 필요 없다).
# 키움 키가 오면 BROKER·CLIENT_*와 함께 지운다 (docs/DECISIONS.md 3-1·23장)
# ALLOW_TOSS_BROKER=off

# 운영할 시장 (KR 또는 KR,US). 키움 미국 시세를 확인하기 전에는 KR만
MARKETS=KR

# --- 모의 계좌 ---
PAPER_CAPITAL_KRW=10000000
PAPER_COMMISSION_KR=0.00015
PAPER_COMMISSION_US=0.00015
# 자동 관리 포지션 총 금액 한도 (원). 비우거나 off면 두지 않는다 (현금이 상한)
# MAX_TOTAL_INVEST_KRW=

# --- AI (DevPass LLM Gateway) ---
DEVPASS_APIKEY=
# ANALYSTS: 모델ID:크기(large | medium | small). 크기가 의결권을 정한다
ANALYSTS=gpt-5.6-luna:medium,gemini-3.8-flash:medium,deepseek-v4.1-flash:small,muse-spark-1.3-contributor:small
RESEARCHERS=gpt-5.6-luna,gemini-3.8-flash
APPROVER=claude-opus-5-5
REQUIRED_MODELS=claude-opus-5-5,gemini-3.8-flash,gpt-5.6-luna
# 하루 전체 AI 비용 한도와 팀원별 하루 분석 요청 종목 수 (웹에서 쓴다)
AI_DAILY_BUDGET_USD=10
AI_DAILY_ANALYSES_PER_USER=5

# --- 재무·공시·공휴일 ---
# DART 전자공시 (opendart.fss.or.kr). 없으면 국내 재무·공시를 건너뛴다
DART_API_KEY=
# 공공데이터포털(data.go.kr) 서비스키. '금융위원회_기업 재무정보'와 '한국천문연구원_특일 정보' 활용신청 필요.
# 특일 정보가 없으면 장 달력이 국내 공휴일을 모른다
DATA_GOKR_API=
# SEC EDGAR 요청에 넣을 연락처 이메일. 없으면 미국 재무·공시를 건너뛴다
SEC_CONTACT_EMAIL=

# --- 알림: 팀 Discord 채널에 알림만 보낸다. Webhook이 있으면 Webhook이 먼저, 없으면 openclaw, 둘 다 없으면 콘솔 ---
# 팀 채널 Webhook 주소 (채널 설정 → 연동 → 웹후크). 비밀 값이다: .env에만 두고 로그·문서·화면에 넣지 않는다.
# 비우면 Discord로는 보내지 않는다 (웹 알림은 남고, Discord 메시지는 콘솔에만)
# 2026-10-08부터 Discord 알림을 꺼 두었다 (코드에서 주석 처리 — docs/DECISIONS.md 24장): 값이 있어도 보내지 않는다
DISCORD_WEBHOOK_URL=
# openclaw(원본 방식). Webhook이 없을 때만 쓴다
# OPENCLAW_TARGET=channel:<팀 채널 ID>
# OPENCLAW_BIN=openclaw
# Discord 메시지에 넣을 웹 화면 주소의 앞부분 (개발: 프론트 주소, 운영: 배포 주소. 예: http://12.34.56.78)
PUBLIC_BASE_URL=http://localhost:5173

# --- AI 추천 · 자동매매 (docs/DECISIONS.md 12장) ---
# 추천을 활성화할 수 있는 기간이자 계획의 진입 기한 (달력 일수)
RECOMMENDATION_VALID_DAYS=3
# 시연용 규칙 추천(AI 아님)을 웹에서 만들 수 있게 할지 (on | off)와 팀원별 하루 시연 추천 수
AUTOTRADE_DEMO=on
AUTOTRADE_DEMO_PER_USER=5
# 매일 자동 추천 (off | demo, 기본 off). demo면 국내 거래일 AUTO_RECOMMEND_AT(KST) 이후 하루 한 번 선별 상위
# AUTO_RECOMMEND_TOP개 종목으로 시연 추천(AI 아님)을 만들어 팀 전체에 알린다. 선별이 증권사 조회를 100번 넘게 해서 하루 한 번만.
# 지금 한 번 돌리기: python manage.py auto_recommend [--force]
AUTO_RECOMMEND=off
AUTO_RECOMMEND_TOP=3
AUTO_RECOMMEND_AT=08:00
# 매일 자동 리포트 (off | on, 기본 off — docs/design/AI_AGENT_WORKFLOW.md). on이면 국내 거래일 AUTO_REPORT_AT(KST) 이후 하루 한 번
# 규칙 선별 → AI 선정 팀 → 선정 Guard → 종목 리포트 AUTO_REPORT_TOP개(1~5)를 만들어 팀 채널(Discord)로 보낸다.
# 증권사 조회 100번 이상 + LLM(DEVPASS_APIKEY)을 부른다. 켜면 위 AUTO_RECOMMEND=demo는 끈다 (같은 종목에 시연 추천이 겹친다).
# 지금 한 번 돌리기: python manage.py auto_report [--force] [--wait]
AUTO_REPORT=off
AUTO_REPORT_TOP=3
AUTO_REPORT_AT=08:00

# --- AI 리포트 (docs/DECISIONS.md 14-6) ---
# 팀원별 하루(KST) AI 리포트 신청 한도 (장애 주입 없이 실패한 리포트는 세지 않는다). 비우면 무제한(기본), 0이면 신청할 수 없다
# (무제한이어도 팀 전체 하루 비용 예산 AI_DAILY_BUDGET_USD는 적용된다)
AI_DAILY_REPORTS_PER_USER=

# --- 장기투자: 오늘의 내 종목 뉴스 · 펀더멘털 점검 (docs/DECISIONS.md 14-3) ---
# 엔진 루프(run_engine)에서 장기투자 예약 작업을 돌릴지 (on | off, 기본 on). 증권사·DART·뉴스·LLM을 부른다
LONGTERM_JOBS=on
# 오늘의 내 종목 뉴스를 만드는 시각 (KST, 국내 거래일, 이 시각 이후 하루 한 번)
DAILY_MOVE_AT=16:30
# 오늘의 내 종목 뉴스 설명에 쓸 LLM 모델. 비우면 APPROVER, 그것도 없으면 템플릿 문장만
DAILY_MOVE_MODEL=
# 펀더멘털 점검 시각 (KST. 그날 정기공시가 나온 종목은 거래일, 전체 재점검은 매주 월요일)
THESIS_CHECK_AT=18:00

# --- Redis: 예약·전략·선별 결과·잠금·엔진 생존 신호 (키 접두사 paper:) ---
REDIS_URL=redis://127.0.0.1:6379/0

# 리포트 PDF용 Chrome (비우면 PATH에서 찾고, 없으면 HTML로 보낸다)
# CHROME_BIN=
# 백업 위치 (비우면 data/backups)
# BACKUP_DIR=
# 실행 데이터 위치 (data/, runs/, .cache/). 비우면 저장소 루트
# PAPER_ROOT=

# --- Django (backend/) ---
# 로컬 개발 값이다. EC2 운영은 DJANGO_DEBUG=off, DJANGO_SECRET_KEY 필수(긴 임의 문자열), ALLOWED_HOSTS에 공인 IP·도메인
DJANGO_DEBUG=on
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DB: POSTGRES_HOST가 비어 있으면 SQLite (backend/db.sqlite3. 혼자 개발할 때의 기본값).
# 팀이 같이 보는 개발 DB: POSTGRES_HOST=127.0.0.1 이면 scripts/dev.sh가 이 PC에 PostgreSQL 컨테이너를 띄워 쓴다
#   (deploy/compose.dev.yml). 그때는 POSTGRES_PASSWORD를 긴 임의 값으로 바꾸고 DJANGO_SECRET_KEY도 채운다.
#   다른 팀원 PC의 개발 DB에 붙으려면 POSTGRES_HOST에 그 PC의 IP를 넣는다 (docs/plans/TEAM_DEV_PLAN.md 12장).
# EC2 운영은 PostgreSQL (EC2의 .env에서 POSTGRES_HOST=db 와 비밀번호를 채운다)
POSTGRES_DB=paper
POSTGRES_USER=paper
POSTGRES_PASSWORD=paper
POSTGRES_HOST=
# 이 PC에서 PostgreSQL 컨테이너를 열 포트 (5432를 다른 프로그램이 쓰면 5434처럼 빈 포트로)
POSTGRES_PORT=5432
# DB 포트를 여는 주소. 기본 127.0.0.1(이 PC에서만). 개발할 때만 0.0.0.0으로 두면 같은 네트워크의 팀원이 DB에 접속한다
# POSTGRES_BIND=0.0.0.0
