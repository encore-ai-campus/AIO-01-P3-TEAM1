# 컨테이너용 설정. 복사해서 .env.docker로 쓰고 값을 채운다:  cp .env.docker.example .env.docker
# .env.docker는 커밋하지 않는다 (운영 값은 EC2의 이 파일에만 둔다). 키 설명은 docs/DECISIONS.md 2장.
# POSTGRES_HOST, POSTGRES_PORT, REDIS_URL, PAPER_ROOT는 docker-compose.yml이 컨테이너에 맞게 넣는다 (여기에 적지 않는다).

# --- 밖에서 들어오는 포트와 이미지 ---
HTTP_PORT=80
# IMAGE_PREFIX=ghcr.io/shs5029/paper-trading
# IMAGE_TAG=local        # 배포할 때는 커밋 해시 (deploy.yml이 넣는다)

# --- Django ---
DJANGO_DEBUG=off
# 긴 임의 문자열. 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# 접속에 쓰는 주소(공인 IP·도메인)를 쉼표로. 예: 12.34.56.78,example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- DB (compose의 db 컨테이너) ---
POSTGRES_DB=paper
POSTGRES_USER=paper
# 긴 임의 문자열
POSTGRES_PASSWORD=

# --- 증권사: 운영은 키움만 쓴다 (조회만. BROKER=toss는 DJANGO_DEBUG=on일 때만 되므로 운영에서는 꺼진다) ---
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
MARKETS=KR

# --- 모의 계좌 ---
PAPER_CAPITAL_KRW=10000000
PAPER_COMMISSION_KR=0.00015
PAPER_COMMISSION_US=0.00015

# --- AI (DevPass LLM Gateway). 비우면 AI 분석이 꺼진다 ---
DEVPASS_APIKEY=
ANALYSTS=
RESEARCHERS=
APPROVER=
REQUIRED_MODELS=
AI_DAILY_BUDGET_USD=10
AI_DAILY_ANALYSES_PER_USER=5

# --- 재무·공시·공휴일 ---
DART_API_KEY=
DATA_GOKR_API=
SEC_CONTACT_EMAIL=
