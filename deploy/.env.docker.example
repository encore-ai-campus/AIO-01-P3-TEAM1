# 컨테이너용 설정. 복사해서 .env.docker로 쓰고 값을 채운다:  cp .env.docker.example .env.docker
# .env.docker는 커밋하지 않는다 (운영 값은 EC2의 이 파일에만 둔다). 키 설명은 docs/DECISIONS.md 2장.
# POSTGRES_HOST, POSTGRES_PORT, REDIS_URL, PAPER_ROOT는 docker-compose.yml이 컨테이너에 맞게 넣는다 (여기에 적지 않는다).

# --- 밖에서 들어오는 포트와 이미지 ---
HTTP_PORT=80
# IMAGE_PREFIX=ghcr.io/shs5029/paper-trading
# IMAGE_TAG=local        # 배포할 때는 커밋 해시 (deploy.yml이 넣는다)

# --- Django ---
DJANGO_DEBUG=off
# 긴 임의 문자열. 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# 접속에 쓰는 주소(공인 IP·도메인)를 쉼표로. 예: 12.34.56.78,example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- DB (compose의 db 컨테이너) ---
POSTGRES_DB=paper
POSTGRES_USER=paper
# 긴 임의 문자열
POSTGRES_PASSWORD=
# 서버 안(127.0.0.1)에만 여는 DB 포트. 관리 서버가 SSH 터널 + 읽기 전용 계정으로 붙는다 (admin/README.md 7-2). 보안 그룹에 열지 않는다
# DB_LOCAL_PORT=15432

# --- 증권사: 운영은 키움만 쓴다 (조회만. BROKER=toss는 DJANGO_DEBUG=on일 때만 되므로 운영에서는 꺼진다) ---
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 키움 키를 받기 전 운영 임시용: DJANGO_DEBUG=off여도 BROKER=toss(+ CLIENT_ID·CLIENT_SECRET)를 받는다. 기본 off.
# 키움 키가 오면 이 줄과 BROKER·CLIENT_*를 지운다 (docs/DECISIONS.md 3-1·23장)
# ALLOW_TOSS_BROKER=off
MARKETS=KR

# --- 모의 계좌 ---
PAPER_CAPITAL_KRW=10000000
PAPER_COMMISSION_KR=0.00015
PAPER_COMMISSION_US=0.00015

# --- AI (DevPass LLM Gateway). 비우면 AI 분석이 꺼진다 ---
DEVPASS_APIKEY=
ANALYSTS=
RESEARCHERS=
APPROVER=
REQUIRED_MODELS=
AI_DAILY_BUDGET_USD=10
AI_DAILY_ANALYSES_PER_USER=5

# --- 재무·공시·공휴일 ---
DART_API_KEY=
DATA_GOKR_API=
SEC_CONTACT_EMAIL=

# --- 알림: 팀 Discord 채널 (Webhook). 엔진 컨테이너에는 openclaw가 없어 운영의 Discord 발송은 Webhook뿐이다 ---
# Webhook 주소는 비밀 값이다 (이 파일에만. 로그·문서에 넣지 않는다). 비우면 Discord로는 보내지 않는다 (웹 알림은 남는다)
# 2026-10-08부터 Discord 알림을 꺼 두었다 (코드에서 주석 처리 — docs/DECISIONS.md 24장): 값이 있어도 보내지 않는다
DISCORD_WEBHOOK_URL=
# Discord 메시지에 넣을 웹 화면 주소 (배포 주소. 예: http://12.34.56.78)
PUBLIC_BASE_URL=http://localhost

# --- AI 추천 · 자동매매 ---
# 추천을 활성화할 수 있는 기간이자 계획의 진입 기한 (달력 일수)
RECOMMENDATION_VALID_DAYS=3
# 시연용 규칙 추천(AI 아님)을 웹에서 만들 수 있게 할지 (on | off)와 팀원별 하루 시연 추천 수
AUTOTRADE_DEMO=on
AUTOTRADE_DEMO_PER_USER=5
# 매일 자동 추천 (off | demo, 기본 off). demo면 국내 거래일 AUTO_RECOMMEND_AT(KST) 이후 하루 한 번 선별 상위
# AUTO_RECOMMEND_TOP개 종목으로 시연 추천(AI 아님)을 만들어 팀 전체에 알린다. 선별이 증권사 조회를 100번 넘게 해서 하루 한 번만.
# 지금 한 번 돌리기: python manage.py auto_recommend [--force]
AUTO_RECOMMEND=off
AUTO_RECOMMEND_TOP=3
AUTO_RECOMMEND_AT=08:00
# 매일 자동 리포트 (off | on, 기본 off — docs/design/AI_AGENT_WORKFLOW.md). on이면 국내 거래일 AUTO_REPORT_AT(KST) 이후 하루 한 번
# 규칙 선별 → AI 선정 팀 → 선정 Guard → 종목 리포트 AUTO_REPORT_TOP개(1~5)를 만들어 팀 채널(Discord)로 보낸다.
# 증권사 조회 100번 이상 + LLM(DEVPASS_APIKEY)을 부른다. 켜면 위 AUTO_RECOMMEND=demo는 끈다 (같은 종목에 시연 추천이 겹친다).
# 지금 한 번 돌리기: python manage.py auto_report [--force] [--wait]
AUTO_REPORT=off
AUTO_REPORT_TOP=3
AUTO_REPORT_AT=08:00

# --- AI 리포트 ---
# 팀원별 하루(KST) AI 리포트 신청 한도 (장애 주입 없이 실패한 리포트는 세지 않는다). 비우면 무제한(기본), 0이면 신청할 수 없다
# (무제한이어도 팀 전체 하루 비용 예산 AI_DAILY_BUDGET_USD는 적용된다)
AI_DAILY_REPORTS_PER_USER=

# --- 장기투자: 오늘의 내 종목 뉴스 · 펀더멘털 점검 ---
# 엔진 컨테이너에서 장기투자 예약 작업을 돌릴지 (on | off, 기본 on). 증권사·DART·뉴스·LLM을 부른다
LONGTERM_JOBS=on
# 오늘의 내 종목 뉴스를 만드는 시각 (KST, 국내 거래일, 이 시각 이후 하루 한 번)
DAILY_MOVE_AT=16:30
# 오늘의 내 종목 뉴스 설명에 쓸 LLM 모델. 비우면 APPROVER, 그것도 없으면 템플릿 문장만
DAILY_MOVE_MODEL=
# 펀더멘털 점검 시각 (KST. 그날 정기공시가 나온 종목은 거래일, 전체 재점검은 매주 월요일)
THESIS_CHECK_AT=18:00
